    "/valorant/schedule": {
      "get": {
        "tags": [
          "Valorant"
        ],
        "summary": "Display the games of the day based on the tournament searched",
        "description": "Display the games of the day based on the tournament searched.",
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "description": "Your channel name, no need to change",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "league",
            "in": "query",
            "description": "Name of the league",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "challengers_br",
                "vct_lock_in",
                "game_changers_series_brazil",
                "last_chance_qualifier_br_and_latam",
                "vct_americas",
                "vct_masters",
                "champions",
                "ascension_americas",
                "last_chance_qualifier_americas",
                "game_changers_championship",
                "vct_emea"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Format of the response",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "text"
              ],
              "default": "text"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
