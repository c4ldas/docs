    "/twitch/prediction/create/{code}": {
      "get": {
        "tags": [
          "Twitch"
        ],
        "summary": "Control Twitch predictions",
        "description": "Create a Twitch prediction.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "description": "Code received by application",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "description": "Twitch channel name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "option1",
            "in": "query",
            "description": "First option of prediction",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "option2",
            "in": "query",
            "description": "Second option of prediction",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "question",
            "in": "query",
            "description": "Question of prediction. Use query escape to include special characters",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/twitch/prediction/close/{code}": {
      "get": {
        "tags": [
          "Twitch"
        ],
        "summary": "Closes a previously created prediction and chooses a winner",
        "description": "Close a previously created Twitch prediction.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "description": "Code received by application",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "description": "Twitch channel name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "winner",
            "in": "query",
            "description": "Prediction result. Should be either one of the options created for option1 or option2",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
