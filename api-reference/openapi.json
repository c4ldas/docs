  "paths": {
    "/valorant/rank": {
      "get": {
        "tags": [
          "Valorant"
        ],
        "summary": "Display your real-time rank and elo in Valorant",
        "description": "Display your real-time rank and elo in Valorant.",
        "parameters": [
          {
            "name": "player",
            "in": "query",
            "description": "Name of the player",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Tag of the player, same as #",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "description": "Region of the player",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "eu",
                "na",
                "latam",
                "br",
                "ap",
                "kr"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Format of the response",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "text"
              ],
              "default": "text"
            }
          },
          {
            "name": "msg",
            "in": "query",
            "description": "Message to be displayed as response",
            "required": false,
            "schema": {
              "type": "string",
              "default": "(player) está (rank) com (pontos) pontos"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "description": "Your Twitch channel",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
